# GEMINI_API_KEY: Required for live Gemini AI responses (Ira agents).
# Copy this file to `.env` in the project root and set your key:
#   cp .env.example .env
# Without a key, FinancialSummaryAgent uses offline simulated responses.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
